{
  "helm-values": {
    "enabled": true
  },
  "postUpdateOptions": ["regexAll"],
  "regexManagers": [
    {
      "fileMatch": ["(^|/)filerise/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "error311/filerise-docker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": ["(^|/)filerise/Chart\\.yaml$"],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "filerise-chart-version",
      "datasourceTemplate": "regex",
      "versioningTemplate": "increment"
    },
    {
      "fileMatch": ["(^|/)komga/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "gotson/komga",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": ["(^|/)komga/Chart\\.yaml$"],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "komga-chart-version",
      "datasourceTemplate": "regex",
      "versioningTemplate": "increment"
    },
    {
      "fileMatch": ["(^|/)adminer/Chart\\.yaml$"],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "adminer",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": ["(^|/)adminer/Chart\\.yaml$"],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "adminer-chart-version",
      "datasourceTemplate": "regex",
      "versioningTemplate": "increment"
    }
  ]
}