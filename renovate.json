{
  "helm-values": {
    "enabled": true
  },
  "postUpdateOptions": [
    "regexAll"
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "(^|/)filerise/Chart\\.yaml$"
      ],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "error311/filerise-docker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [
        "(^|/)adminer/Chart\\.yaml$"
      ],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "adminer",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "fileMatch": [
        "(^|/)cwa/Chart\\.yaml$"
      ],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "crocodilestick/calibre-web-automated",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}